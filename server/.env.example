# Exact public origin, no trailing slash or path. Production must use HTTPS.
ENSTUDY_ORIGIN=https://study.example.com
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ENSTUDY_SECRET=
ENSTUDY_DATABASE=/data/enstudy.sqlite3
ENSTUDY_COOKIE_PATH=/enstudy/api
ENSTUDY_MAX_USERS=1000
# Only enable when the API is private and your edge proxy overwrites X-Real-IP.
ENSTUDY_TRUST_PROXY=1
